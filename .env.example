# Data source ----------------------------------------------------------------
# "mock"     -> in-browser seeded dataset (no Firebase needed, safe for demos)
# "firebase" -> live Firebase Auth + Firestore + Cloud Functions
VITE_DATA_SOURCE=mock

# Firebase web config (safe to expose; access is enforced by Security Rules) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=asia-south1

# Local emulator suite (optional)
VITE_USE_FIREBASE_EMULATORS=false
